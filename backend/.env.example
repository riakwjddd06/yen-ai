# 이 파일을 .env로 복사한 뒤 값을 채우세요: cp .env.example .env
# .env는 GitHub에 올라가지 않습니다. 이 파일에는 실제 키를 쓰지 마세요.

# AI (코디세이 OpenAI 호환 API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5.4
OPENAI_MAX_COMPLETION_TOKENS=3000
# CHAT_RATE_LIMIT_PER_MIN=10

# Firebase: 로컬은 키 파일 경로, 배포(Render)는 FIREBASE_SERVICE_ACCOUNT_JSON에 JSON 내용 전체
FIREBASE_CREDENTIALS_PATH=serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS: 요청을 허용할 프론트 주소 (쉼표로 구분, 끝에 / 없이)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# 데이터 수집 스크립트용 (scripts/fetch_ecos.py)
ECOS_API_KEY=
